# Public HTTP API
HTTP_ADDRESS=:8080
HTTP_CORS_ALLOW_ORIGINS=http://localhost:3000
# Comma-separated CIDRs for reverse proxies whose X-Forwarded-For header is trusted.
HTTP_TRUSTED_PROXY_CIDRS=
# Optional request-ID convention. Empty keys disable receiving or returning it.
HTTP_REQUEST_ID_INCOMING_HEADER=X-Request-ID
HTTP_REQUEST_ID_RESPONSE_HEADER=X-Request-ID
HTTP_REQUEST_ID_REJECT_INVALID=false

# Session security: set true outside local development.
SESSION_COOKIE_SECURE=false

# Optional email delivery. Unset uses the log-only OTP sender.
RESEND_API_KEY=
RESEND_FROM=

# Optional Google OAuth login. Unset disables the provider.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
