# Each enabled workflow owns one reader. Empty TOPIC disables that workflow.
# stop-all stops siblings after a worker failure. independent keeps healthy workers running.
KAFKA_WORKER_FAILURE_POLICY=stop-all
KAFKA_BROKERS=localhost:9092

KAFKA_NOTIFICATION_TOPIC=notifications.requested.v1
KAFKA_NOTIFICATION_SHARE_GROUP_ID=shared-workers-v1
KAFKA_NOTIFICATION_SHARE_WORKER_CONCURRENCY=4
# Default batch size follows this workflow's concurrency.
# KAFKA_NOTIFICATION_SHARE_MAX_POLL_RECORDS=4
KAFKA_NOTIFICATION_SHARE_FETCH_MAX_WAIT=500ms
KAFKA_NOTIFICATION_SHARE_HANDLING_TIMEOUT=10s
KAFKA_NOTIFICATION_SHARE_ACKNOWLEDGMENT_MARGIN=3s
# Broker-owned policy applied by kafka-share-group-init.
KAFKA_NOTIFICATION_SHARE_INITIAL_OFFSET=earliest
KAFKA_NOTIFICATION_SHARE_RECORD_LOCK_MS=30000

# TLS encrypts broker connections and verifies broker certificates.
KAFKA_NOTIFICATION_TLS_ENABLED=false
# Empty uses system CA roots. A file selects the private CA roots in that PEM file.
KAFKA_NOTIFICATION_TLS_SERVER_CA_FILE=
# Set both to present this application's certificate to a mutual-TLS broker.
KAFKA_NOTIFICATION_TLS_CLIENT_CERT_FILE=
KAFKA_NOTIFICATION_TLS_CLIENT_KEY_FILE=
# Empty verifies each broker's hostname, including brokers discovered after startup.
KAFKA_NOTIFICATION_TLS_SERVER_NAME=

# SASL authenticates this application to Kafka. It does not encrypt traffic.
# Options: none, plain, scram-sha-256, scram-sha-512. Use TLS for real credentials.
KAFKA_NOTIFICATION_SASL_MECHANISM=none
KAFKA_NOTIFICATION_SASL_USERNAME=
KAFKA_NOTIFICATION_SASL_PASSWORD=

KAFKA_ACTIVITY_TOPIC=activities.recorded.v1
KAFKA_ACTIVITY_SHARE_GROUP_ID=activity-share-workers-v1
KAFKA_ACTIVITY_SHARE_WORKER_CONCURRENCY=4
# Default batch size follows this workflow's concurrency.
# KAFKA_ACTIVITY_SHARE_MAX_POLL_RECORDS=4
KAFKA_ACTIVITY_SHARE_FETCH_MAX_WAIT=500ms
KAFKA_ACTIVITY_SHARE_HANDLING_TIMEOUT=10s
KAFKA_ACTIVITY_SHARE_ACKNOWLEDGMENT_MARGIN=3s
# Broker-owned policy applied by kafka-share-group-init.
KAFKA_ACTIVITY_SHARE_INITIAL_OFFSET=earliest
KAFKA_ACTIVITY_SHARE_RECORD_LOCK_MS=30000

# TLS encrypts broker connections and verifies broker certificates.
KAFKA_ACTIVITY_TLS_ENABLED=false
# Empty uses system CA roots. A file selects the private CA roots in that PEM file.
KAFKA_ACTIVITY_TLS_SERVER_CA_FILE=
# Set both to present this application's certificate to a mutual-TLS broker.
KAFKA_ACTIVITY_TLS_CLIENT_CERT_FILE=
KAFKA_ACTIVITY_TLS_CLIENT_KEY_FILE=
# Empty verifies each broker's hostname, including brokers discovered after startup.
KAFKA_ACTIVITY_TLS_SERVER_NAME=

# SASL authenticates this application to Kafka. It does not encrypt traffic.
# Options: none, plain, scram-sha-256, scram-sha-512. Use TLS for real credentials.
KAFKA_ACTIVITY_SASL_MECHANISM=none
KAFKA_ACTIVITY_SASL_USERNAME=
KAFKA_ACTIVITY_SASL_PASSWORD=
