# Share Group: workers may handle the same partition concurrently.
# Provision the broker/topic/group before starting this executable.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notifications.requested.v1
KAFKA_SHARE_GROUP_ID=shared-workers-v1
KAFKA_SHARE_WORKER_CONCURRENCY=4
# Start with one acquired record per handler to avoid local waiting.
KAFKA_SHARE_MAX_POLL_RECORDS=4
KAFKA_SHARE_HANDLING_TIMEOUT=10s
# Finish before the estimated lock deadline, leaving time for acknowledgments.
KAFKA_SHARE_ACKNOWLEDGMENT_MARGIN=3s
