# Share Group: workers may handle the same partition concurrently.
# Provision the broker/topic/group before starting this executable.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notifications.requested.v1
KAFKA_SHARE_GROUP_ID=shared-workers-v1
KAFKA_SHARE_WORKER_CONCURRENCY=4
# Start with one acquired record per handler to avoid local waiting.
KAFKA_SHARE_MAX_POLL_RECORDS=4
KAFKA_SHARE_HANDLING_TIMEOUT=10s
# Finish before the estimated lock deadline, leaving time for acknowledgments.
KAFKA_SHARE_ACKNOWLEDGMENT_MARGIN=3s

# TLS encrypts broker connections and verifies broker certificates.
KAFKA_TLS_ENABLED=false
# Empty uses system CA roots. A file selects the private CA roots in that PEM file.
KAFKA_TLS_SERVER_CA_FILE=
# Set both to present this application's certificate to a mutual-TLS broker.
KAFKA_TLS_CLIENT_CERT_FILE=
KAFKA_TLS_CLIENT_KEY_FILE=
# Empty verifies each broker's hostname, including brokers discovered after startup.
KAFKA_TLS_SERVER_NAME=

# SASL authenticates this application to Kafka. It does not encrypt traffic.
# Options: none, plain, scram-sha-256, scram-sha-512. Use TLS for real credentials.
KAFKA_SASL_MECHANISM=none
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
