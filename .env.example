# Common local-development overrides. Other settings use config defaults.
SERVICE_NAME=go-backend-architecture
APP_ENV=local

# HTTP
HTTP_ADDRESS=:8080
HTTP_CORS_ALLOW_ORIGINS=http://localhost:3000
# Comma-separated CIDRs for reverse proxies whose X-Forwarded-For header is trusted.
HTTP_TRUSTED_PROXY_CIDRS=
# Optional request-ID convention. Empty keys disable receiving or returning it.
HTTP_REQUEST_ID_INCOMING_HEADER=X-Request-ID
HTTP_REQUEST_ID_RESPONSE_HEADER=X-Request-ID
HTTP_REQUEST_ID_REJECT_INVALID=false

# gRPC
GRPC_ADDRESS=:9090
GRPC_HEALTH_REFRESH_INTERVAL=10s
GRPC_REQUEST_TIMEOUT=10s
GRPC_MAX_RECV_MESSAGE_BYTES=4194304
GRPC_MAX_SEND_MESSAGE_BYTES=4194304
# Optional request-ID convention. Empty keys disable receiving or returning it.
GRPC_REQUEST_ID_INCOMING_METADATA_KEY=x-request-id
GRPC_REQUEST_ID_RESPONSE_METADATA_KEY=x-request-id
GRPC_REQUEST_ID_REJECT_INVALID=false
# Useful with grpcurl locally; disable unless reflection is intentionally exposed.
GRPC_REFLECTION_ENABLED=true
# Plaintext is convenient locally. Enable TLS when this process terminates its own transport security.
GRPC_SERVER_TLS_ENABLED=false
GRPC_SERVER_TLS_CERT_FILE=
GRPC_SERVER_TLS_KEY_FILE=
# Set a trusted client CA and require client certificates to enable mTLS.
GRPC_SERVER_TLS_CLIENT_CA_FILE=
GRPC_SERVER_TLS_REQUIRE_CLIENT_CERT=false

# Demo gRPC client. It uses plaintext locally and can be configured for TLS or mTLS independently.
GRPC_CLIENT_SERVICE_NAME=grpcclient-demo
GRPC_CLIENT_TARGET=localhost:9090
GRPC_CLIENT_DEPENDENCY_NAME=grpcapi-demo
GRPC_CLIENT_REQUEST_TIMEOUT=3s
GRPC_CLIENT_MAX_RECV_MESSAGE_BYTES=4194304
GRPC_CLIENT_MAX_SEND_MESSAGE_BYTES=4194304
# Only an existing context request ID is propagated; the client never creates one.
GRPC_CLIENT_REQUEST_ID_METADATA_KEY=x-request-id
# Internal demo calls share W3C trace context; disable at untrusted boundaries.
GRPC_CLIENT_TRACE_PROPAGATION_ENABLED=true
GRPC_CLIENT_TLS_ENABLED=false
GRPC_CLIENT_TLS_SERVER_NAME=
GRPC_CLIENT_TLS_SERVER_CA_FILE=
GRPC_CLIENT_TLS_CERT_FILE=
GRPC_CLIENT_TLS_KEY_FILE=

# Data services
DB_URL=postgres://postgres:postgres@localhost:5432/go-backend-architecture?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Observability and logging
# Instrumentation and trace propagation stay active; this only controls OTLP export.
OTEL_EXPORT_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
OTEL_LOG_LEVEL=debug

# Session security: set true outside local development.
SESSION_COOKIE_SECURE=false

# Optional email delivery. Unset uses the log-only OTP sender.
RESEND_API_KEY=
RESEND_FROM=

# Optional Google OAuth login. Unset disables the provider.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
